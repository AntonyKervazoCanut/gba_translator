    },
    {
      "offset": 7918654,
      "raw_bytes": "c7d5e6e0e3e2f000fc0108bbe0e6dddbdce8b800dbe6e9e2e8e7adfbc9e9e600d7e9e6e6d9e2e800e3d6ded9d7e8ddead900dde700e8e300dcd9d5d800e8e3fefc0106bddde2d8d9e600d0e3e0d7d5e2e300fc0108d5e2d800dcd9e0e400c3eae3e6edfae3d6e8d5dde200cde4d9d7dde1d9e200ceccbfcdadff",
      "length": 122,
      "text": "Marlon: <0xFC><0x01><0x08>Alright, grunts.<0xFB>Our current objective is to head to\n<0xFC><0x01><0x06>Cinder Volcano <0xFC><0x01><0x08>and help Ivory<0xFA>obtain Specimen TRES.",
      "pointer_offsets": [
